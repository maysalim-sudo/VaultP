{
  "name": "vaultp",
  "private": true,
  "version": "0.0.1",
  "description": "Personal vault: expenses, debts, documents. Local-first, encrypted, Android + Windows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "package:desktop": "npm run package --workspace @vaultp/desktop"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
