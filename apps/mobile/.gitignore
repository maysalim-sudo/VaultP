.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
# The native project IS tracked.
#
# Expo's default ignores it, on the assumption that prebuild regenerates it from
# app.json. That holds only while nothing in it is hand-edited — and the signing
# configuration and the single-ABI setting are exactly that. Untracked, they
# would vanish on a fresh clone and the build would silently fall back to a
# throwaway debug key. Its own .gitignore still excludes build output.
# /android
